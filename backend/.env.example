# Application Settings
APP_NAME="Evaluating RAG for Enterprise Knowledge"
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
SECRET_KEY=enterprise_rag_evaluator_super_secret_jwt_key_2025

# Vector & Retrieval Settings
EMBEDDING_MODEL=all-MiniLM-L6-v2
DEFAULT_TOP_K=4
SIMILARITY_THRESHOLD=0.35
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# LLM Provider Configuration
# Supported options: 'local' (built-in zero-cost deterministic engine), 'openai', 'gemini', 'anthropic', 'ollama'
DEFAULT_LLM_PROVIDER=local

# API Keys (optional if using 'local' engine)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
